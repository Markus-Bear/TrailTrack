# Doxygen configuration for the TrailTrack backend.
# Run from the backend folder: doxygen
# Settings not listed here keep Doxygen's defaults.

PROJECT_NAME           = "TrailTrack backend"
PROJECT_NUMBER         = $(TRAILTRACK_VERSION)
PROJECT_BRIEF          = "Spring Boot API for trail conditions in Ireland"

INPUT                  = src/main/java
FILE_PATTERNS          = *.java
RECURSIVE              = YES
# Doxygen does not parse Java records; this shows each one to it as a class.
INPUT_FILTER           = "perl doxygen-record-filter.pl"
OUTPUT_DIRECTORY       = build/docs/doxygen

OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_PACKAGE        = YES
EXTRACT_PRIVATE        = NO
SOURCE_BROWSER         = YES

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO

# Class and collaboration diagrams, drawn with Graphviz.
HAVE_DOT               = YES
UML_LOOK               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_LOGFILE           = build/docs/doxygen-warnings.txt
